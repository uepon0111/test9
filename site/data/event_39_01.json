          "character2dId": 20,
          "voiceId": "voice_ev_night_06_01_34_20"
        }
      ]
    },
    {
      "index": 38,
      "speaker": "Mizuki",
      "character2dIds": [
        20
      ],
      "body": "(They're taking a hard look at themselves and facing their problems despite how uncomfortable that might be.)",
