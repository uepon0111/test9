          "character2dId": 20,
          "voiceId": "voice_ev_night_06_01_32_20"
        }
      ]
    },
    {
      "index": 36,
      "speaker": "Mizuki",
      "character2dIds": [
        20
      ],
      "body": "(It all started with Mafuyu saying, “This isn't good enough.” And now, she's found a way to reach not just Mafuyu, but all these other people...)",
