        {
          "character2dId": 20,
          "voiceId": "voice_ev_night_06_01_33_20"
        }
      ]
    },
    {
      "index": 37,
      "speaker": "Mizuki",
      "character2dIds": [
        20
      ],
      "body": "(It's not just Kanade either. Mafuyu and Ena are also really amazing people.)",
