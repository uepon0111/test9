        {
          "character2dId": 19,
          "voiceId": "voice_ev_night_06_01_43_19"
        }
      ]
    },
    {
      "index": 47,
      "speaker": "Mizuki",
      "character2dIds": [
        20
      ],
      "body": "Yeah!\nI hope K and Yuki get to enjoy this too!",
