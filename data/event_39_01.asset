    },
    {
      "TalkCharacters": [
        {
          "Character2dId": 20
        }
      ],
      "WindowDisplayName": "Mizuki",
      "Body": "Oh, it's Ena...\nShe's awake already?",
      "TalkTention": 0,
      "LipSync": 1,
      "MotionChangeFrom": 1,
      "Motions": [
        {
          "Character2dId": 20,
          "MotionName": "w-happy-sad02",
          "FacialName": "face_smallmouth_01",
          "TimingSyncValue": 0.0
        }
      ],
      "Voices": [
        {
          "Character2dId": 20,
          "VoiceId": "voice_ev_night_06_01_41_20",
          "Volume": 1.0
        }
      ],
      "Speed": 0.0,
      "FontSize": 0,
      "WhenFinishCloseWindow": 0,
      "RequirePlayEffect": 0,
      "EffectReferenceIdx": 0,
      "RequirePlaySound": 0,
      "SoundReferenceIdx": 0,
      "TargetValueScale": 0.0
    },
    {
      "TalkCharacters": [
        {
          "Character2dId": 20
        }
      ],
      "WindowDisplayName": "Mizuki",
      "Body": "<Yeah, I saw! Isn't it awesome?! It's like double what we usually get!> And send...",
      "TalkTention": 0,
      "LipSync": 1,
      "MotionChangeFrom": 1,
      "Motions": [
        {
          "Character2dId": 20,
          "MotionName": "w-cool-tilthead04",
          "FacialName": "face_smallmouth_01",
          "TimingSyncValue": 0.0
        }
      ],
      "Voices": [
        {
          "Character2dId": 20,
          "VoiceId": "voice_ev_night_06_01_42_20",
          "Volume": 1.0
        }
      ],
      "Speed": 0.0,
      "FontSize": 0,
      "WhenFinishCloseWindow": 1,
      "RequirePlayEffect": 0,
      "EffectReferenceIdx": 0,
      "RequirePlaySound": 0,
      "SoundReferenceIdx": 0,
      "TargetValueScale": 0.0
    },
    {
      "TalkCharacters": [
        {
          "Character2dId": 19
        }
      ],
      "WindowDisplayName": "Ena",
      "Body": "<Everyone's saying that the video goes really well with the music, so this one might end up becoming our best one yet, you know?>",
      "TalkTention": 0,
      "LipSync": 1,
      "MotionChangeFrom": 1,
      "Motions": [],
      "Voices": [
        {
          "Character2dId": 19,
          "VoiceId": "voice_ev_night_06_01_43_19",
