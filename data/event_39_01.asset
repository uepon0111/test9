      "WindowDisplayName": "Ena",
      "Body": "<You awake? Did you see the view count?>",
      "TalkTention": 0,
      "LipSync": 1,
      "MotionChangeFrom": 1,
      "Motions": [],
      "Voices": [
        {
          "Character2dId": 19,
